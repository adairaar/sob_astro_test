\@writefile{toc}{\contentsline {subsection}{\numberline {1.8}Bayes factor: Matthew 2:9 vocabulary matches the guiding-star narrative tradition}{10}{subsection.1.8}\protected@file@percent }
\newlabel{subsec:bayes}{{1.8}{10}{Bayes factor: Matthew 2:9 vocabulary matches the guiding-star narrative tradition}{subsection.1.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Linguistic incompatibility of Matthew 2:9 with Greek astronomical discourse.} TLG-verified lemma counts (2026-05-10). \textbf  {Left},~Corpus hit counts for each lemma (blue bars, 7--29 occurrences); the Matthew-type usage (red square) scores zero in every case—no hit in the 25-text corpus ($\approx \!622{,}000$ words) belongs to the narrative sense Matthew employs. \textbf  {Right},~Fisher's exact test: $-\log _{10}(p)$ for each of the four features; dashed orange line marks $p = 0.05$, dotted red line the Bonferroni threshold ($\alpha /4 = 0.0125$). Feature~C ({\greekfont ἐπάνω}) individually crosses $p = 0.05$; the joint Fisher combined statistic is $\chi ^2(8) = 21.4$, $p \approx 6.3\times 10^{-3}$, and every drop-one subset remains jointly significant. The corpus includes both mathematical astronomy and astrological texts; the absence of Matthew's vocabulary is uniform across all genres.}}{11}{figure.4}\protected@file@percent }
\newlabel{fig:linguistics}{{4}{11}{\textbf {Linguistic incompatibility of Matthew 2:9 with Greek astronomical discourse.} TLG-verified lemma counts (2026-05-10). \textbf {Left},~Corpus hit counts for each lemma (blue bars, 7--29 occurrences); the Matthew-type usage (red square) scores zero in every case—no hit in the 25-text corpus ($\approx \!622{,}000$ words) belongs to the narrative sense Matthew employs. \textbf {Right},~Fisher's exact test: $-\log _{10}(p)$ for each of the four features; dashed orange line marks $p = 0.05$, dotted red line the Bonferroni threshold ($\alpha /4 = 0.0125$). Feature~C (\grk {ἐπάνω}) individually crosses $p = 0.05$; the joint Fisher combined statistic is $\chi ^2(8) = 21.4$, $p \approx 6.3\times 10^{-3}$, and every drop-one subset remains jointly significant. The corpus includes both mathematical astronomy and astrological texts; the absence of Matthew's vocabulary is uniform across all genres}{figure.4}{}}
\newlabel{eq:pguide}{{2}{11}{Bayes factor: Matthew 2:9 vocabulary matches the guiding-star narrative tradition}{equation.2}{}}
\newlabel{eq:bf}{{3}{11}{Bayes factor: Matthew 2:9 vocabulary matches the guiding-star narrative tradition}{equation.3}{}}
