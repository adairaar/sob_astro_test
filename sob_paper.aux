\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Observational constraints from Matthew 2:9.} \textbf  {a},~Polar sky chart showing the required apparent motion: during the 2-hour guidance phase ({\greekfont προῆγεν}, ``was going before''), the Star must move visibly southward with azimuth within the road corridor $[190^\circ , 210^\circ ]$ toward Bethlehem; it then appears stationary over a specific house (star symbol, {\greekfont ἐστάθη}, ``stood over''). Altitude is not constrained during stopping (any altitude above the horizon is acceptable)—scholarly interpretations of ``stood over'' range from just above the horizon to zenith. \textbf  {b},~The road corridor $[190^\circ , 210^\circ ]$ in the local sky from Bethlehem. The straight-line bearing is $203^\circ $; the road deviates around the central ridge, sweeping between $190^\circ $ and $210^\circ $.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:sky}{{1}{4}{\textbf {Observational constraints from Matthew 2:9.} \textbf {a},~Polar sky chart showing the required apparent motion: during the 2-hour guidance phase (\grk {προῆγεν}, ``was going before''), the Star must move visibly southward with azimuth within the road corridor $[190^\circ , 210^\circ ]$ toward Bethlehem; it then appears stationary over a specific house (star symbol, \grk {ἐστάθη}, ``stood over''). Altitude is not constrained during stopping (any altitude above the horizon is acceptable)—scholarly interpretations of ``stood over'' range from just above the horizon to zenith. \textbf {b},~The road corridor $[190^\circ , 210^\circ ]$ in the local sky from Bethlehem. The straight-line bearing is $203^\circ $; the road deviates around the central ridge, sweeping between $190^\circ $ and $210^\circ $}{figure.1}{}}
