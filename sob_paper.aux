\@writefile{lot}{\contentsline {table}{\numberline {\textbf  {Extended Data Table~1}}{\ignorespaces \textbf  {Orbital survey results: configurations sampled, azimuth corridor pass counts, and best guidance angular velocity, by orbit class (primary epoch JD~1\,719\,755.9, 5~BCE).} ``Azimuth pass'' = number of visible configurations whose azimuth remains within the road corridor $[190^\circ ,\!210^\circ ]\pm 5^\circ $ throughout the entire 2\,h guidance window. ``Best $\omega _\text  {guide}$'' = maximum guidance-phase angular velocity among all azimuth-passing configurations. No configuration satisfies the azimuth, guidance-motion, \emph  {and} stopping criteria simultaneously. Full parameter grids are given in Supplementary Table~S2.}}{20}{table.1}\protected@file@percent }
\newlabel{tab:survey}{{\textbf  {Extended Data Table~1}}{20}{\textbf {Orbital survey results: configurations sampled, azimuth corridor pass counts, and best guidance angular velocity, by orbit class (primary epoch JD~1\,719\,755.9, 5~BCE).} ``Azimuth pass'' = number of visible configurations whose azimuth remains within the road corridor $[190^\circ ,\!210^\circ ]\pm 5^\circ $ throughout the entire 2\,h guidance window. ``Best $\omega _\text {guide}$'' = maximum guidance-phase angular velocity among all azimuth-passing configurations. No configuration satisfies the azimuth, guidance-motion, \emph {and} stopping criteria simultaneously. Full parameter grids are given in Supplementary Table~S2}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {\textbf  {Extended Data Fig.~1}}{\ignorespaces \textbf  {Orbit inversion proof that guidance and stopping are mutually exclusive.} \textbf  {(a)}~Best heliocentric orbit that maximizes southward apparent motion during the guidance phase (red arc). At the guidance epoch the object is above the horizon (altitude $>10^\circ $) and moving southward at $> 2^\circ \,\mathrm  {h}^{-1}$. \textbf  {(b)}~The same orbit propagated forward to the stopping epoch. The object has set below the horizon ($< 0^\circ $ altitude; shown as dashed trajectory), violating the visibility requirement. No orbit simultaneously satisfies guidance motion, stopping, azimuth, and visibility at both epochs. Orbit propagated via Barker's equation (parabolic) and Newton--Raphson Kepler-equation iteration (elliptic / hyperbolic); Earth position from JPL DE430; local horizontal frame at Bethlehem ($31.70^\circ $\,N, $35.20^\circ $\,E, 765~m).}}{21}{figure.1}\protected@file@percent }
\newlabel{fig:proof}{{\textbf  {Extended Data Fig.~1}}{21}{\textbf {Orbit inversion proof that guidance and stopping are mutually exclusive.} \textbf {(a)}~Best heliocentric orbit that maximizes southward apparent motion during the guidance phase (red arc). At the guidance epoch the object is above the horizon (altitude $>10^\circ $) and moving southward at $> 2^\circ \,\mathrm {h}^{-1}$. \textbf {(b)}~The same orbit propagated forward to the stopping epoch. The object has set below the horizon ($< 0^\circ $ altitude; shown as dashed trajectory), violating the visibility requirement. No orbit simultaneously satisfies guidance motion, stopping, azimuth, and visibility at both epochs. Orbit propagated via Barker's equation (parabolic) and Newton--Raphson Kepler-equation iteration (elliptic / hyperbolic); Earth position from JPL DE430; local horizontal frame at Bethlehem ($31.70^\circ $\,N, $35.20^\circ $\,E, 765~m)}{figure.1}{}}
