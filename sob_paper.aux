\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Direction and guidance motion: two-criterion near-impossibility.} Each point is one visible orbital configuration from the full heliocentric parameter space (broad survey) and two Monte Carlo refinement sweeps. The horizontal axis (log scale) shows the maximum azimuth deviation of the object from the road corridor $[190^\circ ,210^\circ ]$ during the guidance phase (0 = perfectly in corridor); the vertical axis (log scale) shows the minimum angular velocity during that same phase (must exceed $2^\circ \,\mathrm  {h}^{-1}$ to {\greekfont προάγειν}). A configuration satisfying both direction \emph  {and} guidance motion simultaneously would fall in the gold-shaded upper-left region (azimuth deviation $<5^\circ $ \emph  {and} motion $>2^\circ \,\mathrm  {h}^{-1}$). That region is essentially empty: green points (corridor orbits, azimuth deviation $<5^\circ $) cluster along the bottom-left, quasi-stationary throughout with guidance speeds ${\sim }0.006^\circ \,\mathrm  {h}^{-1}$ (factor ${\sim }330$ below threshold); fast-moving orbits (upper right) are far outside the road corridor. The single annotated outlier ($e=2.0$, $\Delta \mathrm  {az}=2.1^\circ $, motion $= 2.89^\circ \,\mathrm  {h}^{-1}$) does enter the gold region but fails the third (stopping) criterion, as shown explicitly in Fig.~\ref {fig:scatter}.}}{8}{figure.2}\protected@file@percent }
\newlabel{fig:azmotion}{{2}{8}{\textbf {Direction and guidance motion: two-criterion near-impossibility.} Each point is one visible orbital configuration from the full heliocentric parameter space (broad survey) and two Monte Carlo refinement sweeps. The horizontal axis (log scale) shows the maximum azimuth deviation of the object from the road corridor $[190^\circ ,210^\circ ]$ during the guidance phase (0 = perfectly in corridor); the vertical axis (log scale) shows the minimum angular velocity during that same phase (must exceed $2^\circ \,\mathrm {h}^{-1}$ to \grk {προάγειν}). A configuration satisfying both direction \emph {and} guidance motion simultaneously would fall in the gold-shaded upper-left region (azimuth deviation $<5^\circ $ \emph {and} motion $>2^\circ \,\mathrm {h}^{-1}$). That region is essentially empty: green points (corridor orbits, azimuth deviation $<5^\circ $) cluster along the bottom-left, quasi-stationary throughout with guidance speeds ${\sim }0.006^\circ \,\mathrm {h}^{-1}$ (factor ${\sim }330$ below threshold); fast-moving orbits (upper right) are far outside the road corridor. The single annotated outlier ($e=2.0$, $\Delta \mathrm {az}=2.1^\circ $, motion $= 2.89^\circ \,\mathrm {h}^{-1}$) does enter the gold region but fails the third (stopping) criterion, as shown explicitly in Fig.~\ref {fig:scatter}}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Orbital impossibility of Matthew 2:9.} Each point represents one visible orbital configuration sampled from the full heliocentric parameter space (broad survey) and two Monte Carlo refinement sweeps. The horizontal axis (log scale) shows the \emph  {minimum} angular velocity during the guidance phase (08:00–10:00 local time; must exceed $2^\circ \,\mathrm  {h}^{-1}$ to lead the Magi southward). The vertical axis (log scale) shows the \emph  {maximum} angular velocity during the subsequent stopping phase (10:15–12:00; must fall \emph  {below} $2^\circ \,\mathrm  {h}^{-1}$ to appear stationary over Bethlehem). A configuration satisfying {\greekfont προάγειν} and {\greekfont ἐστάθη} simultaneously would occupy the gold-shaded \emph  {lower-right} region (guidance motion $>2^\circ \,\mathrm  {h}^{-1}$ \emph  {and} stopping motion $<2^\circ \,\mathrm  {h}^{-1}$). That region contains zero orbits of any type—heliocentric elliptic (blue), parabolic (light blue), hyperbolic (orange), or the Monte Carlo sweeps (color-coded by orbit type). Green points (azimuth deviation $<5^\circ $, in-corridor) cluster near the origin: they are quasi-stationary throughout both phases, confirming the anti-correlation already visible in Fig.~\ref {fig:azmotion}. The dashed diagonal ($y=x$) marks equal velocity in both phases; the diagonal is enforced analytically by Kepler's second law — the apparent angular velocity $\omega _\mathrm  {app} = V_\perp /d$ (transverse geocentric speed divided by geocentric distance) changes by at most $\lesssim \!4\%$ over any four-hour window for heliocentric bodies with $d \gtrsim 0.5$\,AU (Supplementary \S  \,S1.8). All points therefore lie near this line. The single annotated outlier ($e=2.0$, $\Delta \mathrm  {az}=2.1^\circ $), which just entered the two-criterion gold region of Fig.~\ref {fig:azmotion}, reaches $2.89^\circ \,\mathrm  {h}^{-1}$ during guidance but retains the same speed during stopping, placing it well above the stopping threshold. Supplementary Fig.~S1 shows each MC sweep separately.}}{9}{figure.3}\protected@file@percent }
\newlabel{fig:scatter}{{3}{9}{\textbf {Orbital impossibility of Matthew 2:9.} Each point represents one visible orbital configuration sampled from the full heliocentric parameter space (broad survey) and two Monte Carlo refinement sweeps. The horizontal axis (log scale) shows the \emph {minimum} angular velocity during the guidance phase (08:00–10:00 local time; must exceed $2^\circ \,\mathrm {h}^{-1}$ to lead the Magi southward). The vertical axis (log scale) shows the \emph {maximum} angular velocity during the subsequent stopping phase (10:15–12:00; must fall \emph {below} $2^\circ \,\mathrm {h}^{-1}$ to appear stationary over Bethlehem). A configuration satisfying \grk {προάγειν} and \grk {ἐστάθη} simultaneously would occupy the gold-shaded \emph {lower-right} region (guidance motion $>2^\circ \,\mathrm {h}^{-1}$ \emph {and} stopping motion $<2^\circ \,\mathrm {h}^{-1}$). That region contains zero orbits of any type—heliocentric elliptic (blue), parabolic (light blue), hyperbolic (orange), or the Monte Carlo sweeps (color-coded by orbit type). Green points (azimuth deviation $<5^\circ $, in-corridor) cluster near the origin: they are quasi-stationary throughout both phases, confirming the anti-correlation already visible in Fig.~\ref {fig:azmotion}. The dashed diagonal ($y=x$) marks equal velocity in both phases; the diagonal is enforced analytically by Kepler's second law — the apparent angular velocity $\omega _\mathrm {app} = V_\perp /d$ (transverse geocentric speed divided by geocentric distance) changes by at most $\lesssim \!4\%$ over any four-hour window for heliocentric bodies with $d \gtrsim 0.5$\,AU (Supplementary \S \,S1.8). All points therefore lie near this line. The single annotated outlier ($e=2.0$, $\Delta \mathrm {az}=2.1^\circ $), which just entered the two-criterion gold region of Fig.~\ref {fig:azmotion}, reaches $2.89^\circ \,\mathrm {h}^{-1}$ during guidance but retains the same speed during stopping, placing it well above the stopping threshold. Supplementary Fig.~S1 shows each MC sweep separately}{figure.3}{}}
